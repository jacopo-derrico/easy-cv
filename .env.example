# OAuth Client ID (applicazione Web) da Google Cloud.
# Scope usato dall'app: https://www.googleapis.com/auth/drive.file
# Origine JavaScript autorizzata: http://localhost:3000
NUXT_PUBLIC_GOOGLE_CLIENT_ID=
# API key (Picker API abilitata) per importare da Drive nel browser.
NUXT_PUBLIC_GOOGLE_API_KEY=
# Numero progetto (Dashboard Cloud → Impostazioni progetto), per Google Picker.
NUXT_PUBLIC_GOOGLE_APP_ID=
